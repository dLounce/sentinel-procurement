{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VendorOffer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_id",
    "unit_price",
    "currency",
    "delivery_days",
    "confidence",
    "quoted_basis",
    "extraction_flag"
  ],
  "properties": {
    "vendor_id": {
      "type": "string",
      "pattern": "^vendor_[a-c]$"
    },
    "unit_price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": ["USD"]
    },
    "delivery_days": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "quoted_basis": {
      "type": "string",
      "enum": ["unit", "total", "unknown"]
    },
    "extraction_flag": {
      "type": "string",
      "enum": [
        "none",
        "tiered",
        "range",
        "conditional",
        "non_usd",
        "missing_price",
        "unparseable_delivery"
      ]
    }
  }
}
